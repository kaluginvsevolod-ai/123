                director: "Хаяо Міядзакі",
                cast: "Румі Хіірагі, Мію Ірино, Марі Нацукі",
                description: "Десятилітня Тіхіро разом з батьками переїжджає до нового містечка. По дорозі вони випадково потрапляють у містичний світ богів, відьом та духів, де її батьків перетворюють на свиней. Дівчинці доводиться проявити хоробрість, щоб врятувати родину.",
                poster: "https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&q=80&w=800",
                trailer: "https://www.youtube.com/embed/ByXuk9QqQkk"
            },
            {
                id: 7,
                title: "Бійцівський клуб",
                originalTitle: "Fight Club",
                year: 1999,
                genre: "Драма",
                rating: 8.8,
                duration: "139 хв",
                director: "Девід Фінчер",
                cast: "Бред Пітт, Едвард Нортон, Гелена Бонем Картер",
                description: "Страждаючи від безсоння та нудьги у сірому офісному житті, безіменний службовець знайомиться з харизматичним продавцем мила Тайлером Дерденом. Разом вони створюють таємний бійцівський клуб, що переростає у глобальний рух проти споживацького суспільства.",
                poster: "https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&q=80&w=800",
                trailer: "https://www.youtube.com/embed/SUXWAEX2jlg"
            }
        ];

        let currentCategory = 'all';
        let searchQuery = '';
        let watchlist = JSON.parse(localStorage.getItem('kino_watchlist')) || [];
        let activeModalMovieId = null;

        // Initialize application on load
        window.onload = function() {
            renderMovies();
            updateWatchlistBadge();
        };

        // Render movie grid based on filters & search
        function renderMovies() {
            const grid = document.getElementById('movieGrid');
            const noResults = document.getElementById('noResults');
            
            let filtered = movies.filter(movie => {
                const matchesCategory = currentCategory === 'all' || movie.genre === currentCategory;
                const query = searchQuery.toLowerCase();
                const matchesSearch = movie.title.toLowerCase().includes(query) || 
                                      movie.originalTitle.toLowerCase().includes(query) ||
                                      movie.director.toLowerCase().includes(query) ||
                                      movie.year.toString().includes(query);
                return matchesCategory && matchesSearch;
            });

            if (filtered.length === 0) {
                grid.innerHTML = '';
                noResults.classList.remove('hidden');
                return;
            }

            noResults.classList.add('hidden');
            grid.innerHTML = filtered.map(movie => {
                const isSaved = watchlist.includes(movie.id);
                return `
                    <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-lg hover:border-amber-500/50 transition-all duration-300 flex flex-col group">
                        <div class="relative aspect-[2/3] overflow-hidden bg-slate-950 cursor-pointer" onclick="openMovieModal(${movie.id})">
                            <img src="${movie.poster}" alt="${movie.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.src='https://placehold.co/400x600/1e293b/cbd5e1?text=Poster'">
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent opacity-60"></div>
                            <div class="absolute top-3 right-3 flex items-center space-x-1 bg-slate-950/80 backdrop-blur-md px-2.5 py-1 rounded-xl border border-slate-800 text-amber-400 font-bold text-xs">
                                <i class="fa-solid fa-star"></i>
                                <span>${movie.rating}</span>
                            </div>
                            <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between">
                                <span class="px-2.5 py-1 bg-slate-950/80 backdrop-blur-md rounded-lg text-xs font-medium border border-slate-800 text-slate-300">${movie.genre}</span>
                                <span class="text-xs font-semibold text-slate-400">${movie.year}</span>
                            </div>
                        </div>
                        <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
                            <div>
                                <h3 onclick="openMovieModal(${movie.id})" class="font-bold text-base text-white hover:text-amber-400 cursor-pointer transition-colors line-clamp-1">${movie.title}</h3>
                                <p class="text-xs text-slate-400 mt-0.5 line-clamp-1">${movie.originalTitle}</p>
                            </div>
                            <div class="flex items-center justify-between pt-2 border-t border-slate-800/80">
                                <button onclick="openMovieModal(${movie.id})" class="text-xs font-semibold text-amber-400 hover:text-amber-300 flex items-center space-x-1.5 transition-colors">
                                    <i class="fa-solid fa-circle-info"></i>
                                    <span>Детальніше</span>
                                </button>
                                <button onclick="toggleWatchlist(${movie.id})" class="w-8 h-8 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 flex items-center justify-center text-xs transition-all ${isSaved ? 'text-amber-500 border-amber-500/50 bg-amber-500/10' : 'text-slate-300'}">
                                    <i class="${isSaved ? 'fa-solid' : 'fa-regular'} fa-bookmark"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        // Category filter handler
        function filterCategory(cat) {
            currentCategory = cat;
            document.querySelectorAll('.category-btn').forEach(btn => {
                btn.className = "category-btn px-4 py-2 rounded-xl text-sm font-semibold whitespace-nowrap bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-800 transition-all";
            });
            const activeBtn = document.getElementById(`cat-${cat}`);
            if (activeBtn) {
                activeBtn.className = "category-btn px-4 py-2 rounded-xl text-sm font-semibold whitespace-nowrap bg-amber-500 text-slate-950 transition-all shadow-md shadow-amber-500/20";
            }
            renderMovies();
        }

        // Search handler
        function handleSearch(val) {
            searchQuery = val;
            // Sync mobile and desktop inputs
            document.getElementById('searchInput').value = val;
            document.getElementById('mobileSearchInput').value = val;
            renderMovies();
        }

        // Reset filters
        function resetFilters() {
            searchQuery = '';
            document.getElementById('searchInput').value = '';
            document.getElementById('mobileSearchInput').value = '';
            filterCategory('all');
        }

        // Watchlist toggle logic
        function toggleWatchlist(movieId) {
            const index = watchlist.indexOf(movieId);
            if (index > -1) {
                watchlist.splice(index, 1);
            } else {
                watchlist.push(movieId);
            }
            localStorage.setItem('kino_watchlist', JSON.stringify(watchlist));
            renderMovies();
            updateWatchlistBadge();
            if (activeModalMovieId === movieId) {
                updateModalWatchlistState(movieId);
            }
            if (!document.getElementById('watchlistModal').classList.contains('hidden')) {
                renderWatchlistModalContent();
            }
        }

        function toggleWatchlistFromModal() {
            if (activeModalMovieId !== null) {
                toggleWatchlist(activeModalMovieId);
            }
        }

        function updateWatchlistBadge() {
            const badge = document.getElementById('watchlistBadge');
            badge.innerText = watchlist.length;
        }

        // Modal open / close logic
        function openMovieModal(movieId) {
            activeModalMovieId = movieId;
            const movie = movies[movieId];
            if (!movie) return;

            document.getElementById('modalTitle').innerText = movie.title;
            document.getElementById('modalGenre').innerText = movie.genre;
            document.getElementById('modalYear').innerText = movie.year;
            document.getElementById('modalDuration').innerText = movie.duration;
            document.getElementById('modalRating').innerText = movie.rating;
            document.getElementById('modalDirector').innerText = movie.director;
            document.getElementById('modalCast').innerText = movie.cast;
            document.getElementById('modalDesc').innerText = movie.description;
            document.getElementById('modalTrailer').src = movie.trailer;

            updateModalWatchlistState(movieId);

            const modal = document.getElementById('movieModal');
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                document.getElementById('modalContentBox').classList.remove('scale-95');
                document.getElementById('modalContentBox').classList.add('scale-100');
            }, 10);
        }

        function updateModalWatchlistState(movieId) {
            const isSaved = watchlist.includes(movieId);
            const btnText = document.getElementById('modalWatchlistText');
            const btnIcon = document.querySelector('#modalWatchlistBtn i');
            
            if (isSaved) {
                btnText.innerText = "У збережених";
                btnIcon.className = "fa-solid fa-bookmark text-amber-500";
            } else {
                btnText.innerText = "У список збережених";
                btnIcon.className = "fa-regular fa-bookmark";
            }
        }

        function closeMovieModal() {
            const modal = document.getElementById('movieModal');
            modal.classList.add('opacity-0');
            document.getElementById('modalContentBox').classList.remove('scale-100');
            document.getElementById('modalContentBox').classList.add('scale-95');
            document.getElementById('modalTrailer').src = ""; // Stop trailer
            setTimeout(() => {
                modal.classList.add('hidden');
                activeModalMovieId = null;
            }, 300);
        }

        // Watchlist Modal logic
        function openWatchlistModal() {
            renderWatchlistModalContent();
            const modal = document.getElementById('watchlistModal');
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
            }, 10);
        }

        function closeWatchlistModal() {
            const modal = document.getElementById('watchlistModal');
            modal.classList.add('opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        }

        function renderWatchlistModalContent() {
            const container = document.getElementById('watchlistContainer');
            const emptyState = document.getElementById('emptyWatchlist');

            if (watchlist.length === 0) {
                container.innerHTML = '';
                emptyState.classList.remove('hidden');
                return;
            }

            emptyState.classList.add('hidden');
            container.innerHTML = watchlist.map(id => {
                const movie = movies[id];
                if (!movie) return '';
                return `
                    <div class="flex items-center justify-between p-3 bg-slate-950/60 border border-slate-800 rounded-2xl gap-4">
                        <div class="flex items-center space-x-3 cursor-pointer" onclick="closeWatchlistModal(); openMovieModal(${movie.id})">
                            <img src="${movie.poster}" alt="${movie.title}" class="w-12 h-16 object-cover rounded-xl border border-slate-800">
                            <div>
                                <h5 class="font-bold text-sm text-white hover:text-amber-400 transition-colors">${movie.title}</h5>
                                <p class="text-xs text-slate-400 mt-0.5">${movie.genre} • ${movie.year}</p>
                            </div>
                        </div>
                        <div class="flex items-center space-x-2">
                            <button onclick="closeWatchlistModal(); openMovieModal(${movie.id})" class="p-2 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-300 text-xs transition-all" title="Переглянути">
                                <i class="fa-solid fa-play"></i>
                            </button>
                            <button onclick="toggleWatchlist(${movie.id})" class="p-2 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 border border-rose-500/30 text-rose-400 text-xs transition-all" title="Видалити">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                    </div>
                `;
            }).join('');
        }
    </script>
</body>
</html>
